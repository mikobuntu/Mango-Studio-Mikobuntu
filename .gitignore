/target
/target-*/
target-dev/

# Project files and audio never belong in the repo
*.flp
*.wav

# The startup sound is an app asset baked into the binary (like the factory pack)
!crates/os-app/assets/samples/startup.wav

# Local notes and secrets
.env
CLAUDE.md
.claude/

# macOS Finder metadata
.DS_Store

# Python bytecode from the icon tooling
__pycache__/

# Gradle and Android build leftovers
android/.gradle/
android/app/build/
android/local.properties
*.apk
!tools/**/*.apk
